{
  "name": "landsales",
  "version": "1.0.0",
  "private": true,
  "description": "GIS-first land sales web application. Map-first interface for exploring and viewing property for sale.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:standalone": "vite build --base=/",
    "clean:portfolio": "node -e \"require('fs').rmSync('dist-portfolio',{recursive:true,force:true}) && console.log('cleaned dist-portfolio')\"",
    "build:portfolio": "npm run clean:portfolio && vite build --base=/demos/properties/ --outDir=dist-portfolio/demos/properties --emptyOutDir",
    "deploy": "npx wrangler deploy",
    "deploy:portfolio": "npm run build:portfolio && npx wrangler deploy --config wrangler.portfolio.toml",
    "preview": "vite preview"
  },
  "dependencies": {
    "maplibre-gl": "^4.3.2"
  },
  "devDependencies": {
    "puppeteer-core": "^25.9.0",
    "sharp": "^0.35.4",
    "vite": "^5.4.0"
  }
}
